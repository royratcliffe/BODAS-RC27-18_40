      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM7_17" shortName="DTC0x10A900" description="Internal Hardware/Microcontroller error. An SRI transaction failed (bus error/response fault) and the transfer cannot be trusted. This may affect instruction or data transfers between masters and slaves on the SRI fabric. Please restart the ECU." hexValue="0x10A900" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
