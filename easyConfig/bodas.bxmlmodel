      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM7_13" shortName="DTC0x10A500" description="Internal Hardware/Microcontroller error. LMU lockstep control fault due to misconfiguration or comparator logic issues, causing incorrect enabling, timing, or handling of lockstep checks and potentially masking mismatches. Please restart the ECU." hexValue="0x10A500" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM7_12" shortName="DTC0x10A400" description="Internal Hardware/Microcontroller error. A stuck-at or functional fault in the LMU lockstep comparator logic that causes incorrect match/mismatch indications potentially masking real divergences. Please restart the ECU." hexValue="0x10A400" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
