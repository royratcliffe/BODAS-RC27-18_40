      <diagnostictroublecode longName="DFC_rbr_mo_OV_SAV_LSS_MEAS_CLUSTER_1_3" shortName="DTC0x082A00" description="Detection of overvoltage (threshold voltage: greater than 10.5 V) on the LSS_MEAS_CL13 signal (Low Side Shut-Off path test on cluster 1,3). If the measured voltage exceeds 10.5 V, the error reaction is to Shut-OFF of the low-side power outputs." hexValue="0x082A00" dfesPriority="DFES_MaxHighPrio" debounceMethod="TimeUpDown" calParamName="DFC_rbr_mo_OV_SAV_LSS_MEAS_CLUSTER_1_3" defectLimit="50" okLimit="0" ratio="1" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_rbr_mo_OV_SAV_LSS_MEAS_CLUSTER_2" shortName="DTC0x082800" description="Detection of overvoltage (threshold voltage: greater than 10.5 V) on the LSS_MEAS_CL2 signal (Low Side Shut-Off path test on cluster 2). If the measured voltage exceeds 10.5 V, the error reaction is to Shut-Off of the low-side power outputs." hexValue="0x082800" dfesPriority="DFES_MaxHighPrio" debounceMethod="TimeUpDown" calParamName="rbr_mo_OV_SAV_LSS_MEAS_CLUSTER_2" defectLimit="50" okLimit="0" ratio="1" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
