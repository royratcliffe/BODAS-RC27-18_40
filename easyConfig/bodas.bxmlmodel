      <diagnostictroublecode longName="DFC_CANSM_E_BUS_OFF_NETWORK_2" shortName="DTC0x104E00" description="CAN Controller in CAN_3 was in Bus off state (CAN_H and CAN_L shorted, baudrate mismatch between nodes etc.,). Check hardware wiring and also check baudrates of connected nodes." hexValue="0x104E00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
