      <diagnostictroublecode longName="DFC_ComCntESP_05" shortName="DTC0x102200" description="DFC report for Alive Counter status for PDU ESP. Please restart the ECU." hexValue="0x102200" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
