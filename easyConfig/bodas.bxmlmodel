      <diagnostictroublecode longName="DFC_ComCntESP_07" shortName="DTC0x102300" description="DFC report for Alive Counter status for PDU ESP. Please restart the ECU." hexValue="0x102300" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM3_4" shortName="DTC0x108A00" description="Internal Hardware/Microcontroller error. Uncorrectable ECC failure detected in PCACHE tag memory for CPU3. Please restart the ECU." hexValue="0x108A00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM3_5" shortName="DTC0x108B00" description="Internal Hardware/Microcontroller error. Miscellaneous uncorrectable ECC error detected in PCACHE tag storage for CPU3. Please restart the ECU." hexValue="0x108B00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM3_7" shortName="DTC0x108C00" description="Internal Hardware/Microcontroller error. Uncorrectable ECC error detected in PSPR/PCACHE on CPU3. ECC could not correct the error; processor status or cache state may be corrupted and execution integrity is at risk. Please restart the ECU." hexValue="0x108C00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MoXEMMHwLTRegMonTest" shortName="DTC0x10D400" description="A register-monitor self-test failure occurred because the on-chip register monitoring and validation reported an error. Please restart the ECU." hexValue="0x10D400" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
