      <diagnostictroublecode longName="DFC_DSMDummy" shortName="DTC0x100F00" description="Dummy element to guarantee that at least one element is defined. This dummy DFC will be removed." hexValue="0x100F00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM2_22" shortName="DTC0x108600" description="Internal Hardware/Microcontroller error. EDC (Error Detection Code) failure detected on the SRI instruction-fetch interface for CPU2. Please restart the ECU." hexValue="0x108600" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
