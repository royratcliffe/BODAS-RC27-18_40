      <diagnostictroublecode longName="DFC_OCWDAErrPin" shortName="DTC0x098B00" description="The DFC is set if the status of the error pin is active and there is no error in query response communication with external watchdog." hexValue="0x098B00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
