      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM6_15" shortName="DTC0x109C00" description="Internal HW/Microcontroller error: Uncorrectable ECC fault in ERAY memory or state. Parity/metadata inconsistency or a controller anomaly makes ERAY config, buffers, and protocol state unreliable. Please restart the ECU." hexValue="0x109C00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM21_16" shortName="DTC0x10CF00" description="Internal Hardware/Microcontroller error. Internal SMU_Core fault detected. The SMU core (error-management / DFC aggregation / watchdog orchestration) reported an internal error or inconsistent state. Please restart the ECU." hexValue="0x10CF00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM6_14" shortName="DTC0x109B00" description="Internal Hardware/Microcontroller error. Uncorrectable ECC failure detected in ERAY module memory/state. ERAY internal configuration, buffers, or protocol state may be corrupted. Please restart the ECU." hexValue="0x109B00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM6_12" shortName="DTC0x109A00" description="Internal HW/Microcontroller error: Uncorrectable ECC fault in the GTM due to a module or controller anomaly. GTM state/metadata is compromised, making timers, scheduling, PWM, and capture/compare unreliable. Please restart the ECU." hexValue="0x109A00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM9_3" shortName="DTC0x10C000" description="Internal Hardware/Microcontroller error. Over-voltage condition detected on an EVR monitored rail. Measured voltage exceeds configured safe threshold. Please restart the ECU." hexValue="0x10C000" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM6_11" shortName="DTC0x109900" description="Internal Hardware/Microcontroller error. Unrecoverable ECC failure in GTM memory or state. GTM registers, buffers, or tables may be corrupted, and GTM timing, PWM, or output behavior cannot be trusted. Please restart the ECU." hexValue="0x109900" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_ComTOutACC_06" shortName="DTC0x103000" description="DFC report for Timeout status for PDU ACC. Please restart the ECU." hexValue="0x103000" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM9_15" shortName="DTC0x10C100" description="Internal Hardware/Microcontroller error. EVR detected a short or rail fault (hard short to low or short-to-high) on a monitored power rail. Please restart the ECU." hexValue="0x10C100" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM11_8" shortName="DTC0x10CB00" description="Internal Hardware/Microcontroller error. LMU read-phase EDC error detected: a read transaction returned data that failed EDC validation. Read data integrity cannot be trusted. Please restart the ECU." hexValue="0x10CB00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM11_9" shortName="DTC0x10CC00" description="Internal Hardware/Microcontroller error. EDC (Error Detection Code) mismatch detected during the read/data phase of an SRI transfer on the SPB/SFI path. Please restart the ECU." hexValue="0x10CC00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM11_3" shortName="DTC0x10C800" description="Internal Hardware/Microcontroller error. EDC (Error Detection Code) failure detected during the write/data phase of an XBAR-routed transaction. Please restart the ECU." hexValue="0x10C800" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM11_4" shortName="DTC0x10C900" description="Internal Hardware/Microcontroller error. EDC address-phase error detected on DMU transaction. The address/control phase failed EDC checking while accessing DMU. Please restart the ECU." hexValue="0x10C900" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM11_5" shortName="DTC0x10CA00" description="Internal Hardware/Microcontroller error. EDC write-phase error detected on DMU access. The data payload of a write transaction failed integrity checking (EDC/parity mismatch). Please restart the ECU." hexValue="0x10CA00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM10_16" shortName="DTC0x10C200" description="Internal HW/Microcontroller error: Recovery Timer 0 (secondary watchdog) expired. It reacts to SMU watchdog alarms and triggers an SMU reset if the main watchdog also times out. Please restart the ECU." hexValue="0x10C200" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MOXEMM_SMU_ALM10_17" shortName="DTC0x10C300" description="Internal HW/Microcontroller error: Recovery Timer 1 (secondary watchdog) expired. It responds to SMU watchdog alarms and triggers an SMU reset if the main watchdog also times out. Please restart the ECU." hexValue="0x10C300" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_MoXEMMHwLTUCBCfg" shortName="DTC0x10D700" description="A UCB configuration check has failed, which indicates that the on-chip UCB configuration registers did not pass CRC, checksum, or consistency validation and may be corrupted. Please restart the ECU." hexValue="0x10D700" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_CANSM_E_BUS_OFF_NETWORK_0" shortName="DTC0x104C00" description="CAN Controller in CAN_1 was in Bus off state (CAN_H and CAN_L shorted, baudrate mismatch between nodes etc.,). Check hardware wiring and also check baudrates of connected nodes." hexValue="0x104C00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
      <diagnostictroublecode longName="DFC_CANSM_E_BUS_OFF_NETWORK_3" shortName="DTC0x104F00" description="CAN Controller in CAN_4 was in Bus off state (CAN_H and CAN_L shorted, baudrate mismatch between nodes etc.,). Check hardware wiring and also check baudrates of connected nodes." hexValue="0x104F00" dfesPriority="DFES_LowPrio" debounceMethod="NoDebounce" edClass="ED_Class1" spn="0x00" fmi="0x00" mil="No" rsl="No" awl="No" protectLamp="No"/>
