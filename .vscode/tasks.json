{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prettify_json",
      "type": "shell",
      "command": "python scripts/prettify_json.py",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "extract_st",
      "type": "shell",
      "command": "python scripts/extract_st.py",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "update_st",
      "type": "shell",
      "command": "python scripts/update_st.py",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "update_version",
      "type": "shell",
      "command": "python scripts/update_version.py",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "unzip_latest_build",
      "type": "shell",
      "command": "python scripts/unzip_latest_build.py -o .",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "remove .gitignore",
      "type": "shell",
      "command": "Remove-Item -ErrorAction SilentlyContinue .gitignore"
    },
    {
      "label": "run_flashing_tool",
      "type": "process",
      "command": "${workspaceFolder}\\FlashingUtilities\\bds_flashing_tool.exe",
      "args": [
        "${workspaceFolder}\\config.ini"
      ],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
