    AUTOSAR_EthSM_CompuMethods_EthSM_Enum_NetworkModeStateType
    1
    100
    0.0
    255.
    FORMAT "%5.0"
    ECU_ADDRESS 0x70006E89
    MATRIX_DIM 1 


/end MEASUREMENT




