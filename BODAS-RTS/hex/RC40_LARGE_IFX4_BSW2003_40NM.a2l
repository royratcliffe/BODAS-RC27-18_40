      /* repetition rate */ 1
      /begin QP_BLOB
        /* RASTER_ID                             */ 3
        /* raster priority [1..32]               */ 1
        /* worst case raster time [us]           */ 90000
        /begin ETK_XETK_SPECIFIC
          /* hardware trigger                      */ TRG_NBR 0
