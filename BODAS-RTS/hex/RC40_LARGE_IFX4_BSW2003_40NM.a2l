    "e_:Array to hold float values of sensors:_e;d_:SW Version der Applikationsdaten:_d"
    FLOAT32_IEEE
    OneToOne
    1
    100
    -1.00000000E+037
    1.00000000E+037

    
    FORMAT "%13.3"
    MATRIX_DIM 8  
    ECU_ADDRESS 0x600033A4

    /begin IF_DATA ETK_XETK DEFAULT_RASTERS 2 /end IF_DATA
    /begin IF_DATA XCPplus 0x0102 /begin DAQ_EVENT VARIABLE /end DAQ_EVENT /end IF_DATA
/end MEASUREMENT

