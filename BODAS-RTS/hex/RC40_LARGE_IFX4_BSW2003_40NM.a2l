       PRIORITY 4 /* service point priority */
    /end SERVICE_POINT
     SBB_DYNAMIC_STRUCTURE
       2 /* SBBDynStructVer */
       0xB93F5898 /* ResWorkArea: resource working area address,
         where resource blocks and address tables and default value tables are
         allocated. Located e.g. in ETK DATA region for parallel ETK types and ETK
         RAM regions for serial ETK types */
       0x2F70 /* ResWorkArea: length of the resource working
         area in bytes */
       0xB93F8810 /* EcuWrtblResWorkArea: where RAM resource blocks
         and data tables are allocated. Located e.g. in ETK RAM for parallel ETKs
         and ECU RAM for serial ETKs */
       12000 /* EcuWrtblResWorkAreaLength: length of the ECU
          writable resource working area in bytes */
               /* ---------------------------------------- */
    /begin TRIGGER_SEPARATED_FROM_CHANNEL
        /begin TRIGGER_CFG
          TRIGGER 1 DIRECT
          TRIGGER 2 DIRECT
          TRIGGER 3 DIRECT
          TRIGGER 4 DIRECT
          TRIGGER 5 DIRECT
          TRIGGER 6 DIRECT
          TRIGGER 7 DIRECT
