     "rba_SvbbEtk_DisableProcExec_KWB" /* DisableFctExec*/
     /begin IMPLEMENTED_SBB_VERSIONS
        SBB_V2_1
        SBB_V3_1
     /end IMPLEMENTED_SBB_VERSIONS
/* ---------------------------------------- */
    /begin SERVICE_POINT
       2 /* service point number */
